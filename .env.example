# Bothost sets TELEGRAM_BOT_TOKEN automatically for Telegram bots.
TELEGRAM_BOT_TOKEN=

# Free-first AI providers. The bot works if at least one provider key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Asnwero Reply Assistant

# xAI/Grok API is optional and disabled by default because it can be paid.
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning
XAI_ENABLED=false

# Keep false unless you explicitly allow paid API usage.
ALLOW_PAID_MODELS=false

DATABASE_PATH=/app/data/bot.sqlite3
REQUEST_TIMEOUT_SECONDS=20
MAX_SOURCE_CHARS=4000
MAX_CONTEXT_CHARS=1000
RATE_LIMIT_PER_HOUR=10
TASK_TTL_HOURS=24
LOG_LEVEL=INFO
